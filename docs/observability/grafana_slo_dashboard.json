{
  "title": "ACOS Baseline SLO Dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Journey Availability %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(acos_journey_requests_total{status=\"success\"}[5m])) / clamp_min(sum(rate(acos_journey_requests_total[5m])), 1)",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 2,
      "title": "Journey Latency P95 (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le, journey_type) (rate(acos_journey_duration_seconds_bucket[5m])))",
          "legendFormat": "{{journey_type}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "API Errors by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (endpoint, error_type) (rate(acos_api_errors_total[5m]))",
          "legendFormat": "{{endpoint}} {{error_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Journey Cost (USD)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(acos_journey_cost_dollars_sum[5m])) / clamp_min(sum(rate(acos_journey_cost_dollars_count[5m])), 1)",
          "legendFormat": "avg_cost"
        }
      ]
    }
  ]
}
