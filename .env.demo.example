# ACOS single-image demo mode.
# Start with:
# docker run --env-file .env.demo -p 8000:8000 -v acos-data:/data ghcr.io/rastogivaibhav/acos:1.0.0

ACOS_INSTALL_MODE=demo
OPS_ENVIRONMENT=dev
ACOS_PLATFORM_MODE=demo
ACOS_DEMO_PERSISTENCE=sqlite
ACOS_DEMO_DB_PATH=/data/acos_demo.db
PORT=8000

ALLOW_INSECURE_DEV_AUTH=1
ALLOW_MOCK_ROUTES=1
SHOPPER_API_KEYS=dev-key-insecure
OPS_JWT_SECRET=dev-ops-secret-change-me
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

GOOGLE_API_KEY=
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_MODEL=
DOCKER_OPENAI_BASE_URL=
DOCKER_OPENAI_MODEL=

APP_VERSION=1.0.0-demo
ACOS_RUNTIME_PREFERENCE=auto
