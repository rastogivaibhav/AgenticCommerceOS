# Environment variables for ACOS — copy to .env and fill in real values
# NEVER commit .env to version control

# Database
DATABASE_URL=postgresql://acos:CHANGE_ME_STRONG_PASSWORD@db:5432/acos

# Shopper API — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHOPPER_API_KEYS=key1_replace_me,key2_replace_me

# Ops API — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
OPS_JWT_SECRET=replace_me_with_256_bit_random_string

# CORS — comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=https://shop.example.com,https://ops.example.com

# Google GenAI (optional — ADK falls back to local mode if unset)
GOOGLE_API_KEY=

# AgentFabric (optional — fails safely if unset)
AGENTFABRIC_URL=
AGENTFABRIC_API_KEY=

# App version (set in CI)
APP_VERSION=1.0.0
