# Environment variables for ACOS — copy to .env and fill in real values
# NEVER commit .env to version control

# Database
DATABASE_URL=postgresql://acos:CHANGE_ME_STRONG_PASSWORD@db:5432/acos
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=5432

# Shopper API — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHOPPER_API_KEYS=key1_replace_me,key2_replace_me

# Ops API — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
OPS_JWT_SECRET=replace_me_with_256_bit_random_string

# Dev convenience only: set to 1 to allow insecure local auth fallbacks.
# Keep this 0 (or unset) in staging/production.
ALLOW_INSECURE_DEV_AUTH=0

# CORS — comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=https://shop.example.com,https://ops.example.com

# Optional frontend override (if running UI separately from ops-api host)
VITE_API_URL=

# Google GenAI (optional — ADK falls back to local mode if unset)
GOOGLE_API_KEY=

# AgentFabric (optional — fails safely if unset)
AGENTFABRIC_URL=
AGENTFABRIC_API_KEY=

# App version (set in CI)
APP_VERSION=1.0.0
OPS_ENVIRONMENT=dev
ACOS_PLATFORM_MODE=normal
ACOS_RUNTIME_PREFERENCE=auto
ALLOW_MOCK_ROUTES=1
ALLOW_NON_DEV_MOCK_ROUTES=0

# Local OpenAI-compatible LLMs (optional)
# Host-local examples: LM Studio, Ollama with an OpenAI shim, vLLM, LocalAI
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_MODEL=

# Docker-routed local LLMs (optional)
# Examples: a compose service exposed as http://llm:1234/v1 or a host service reachable via host.docker.internal
DOCKER_OPENAI_BASE_URL=
DOCKER_OPENAI_MODEL=

# Week-10 tenancy protections
TENANT_RATE_LIMIT_PER_MINUTE=120
TENANT_DAILY_QUOTA=5000
TENANT_MAX_IN_FLIGHT=8

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0

# Telegram Bot API (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=

# Chat API — Slack integration (optional)
# Optional: dedicated JWT secret for chat-api auth.
# If omitted, chat-api falls back to OPS_JWT_SECRET.
CHAT_JWT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=default
