# ACOS production environment example. Never commit real secrets.
ACOS_INSTALL_MODE=production
ACOS_PLATFORM_MODE=normal
DATABASE_URL=postgresql://acos_user:REPLACE_WITH_SECRET@db:5432/acos_db
POSTGRES_DB=acos_db
POSTGRES_USER=acos_user
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
OPS_AUTH_ENABLED=true
OPS_JWT_ISSUER=acos-ops
OPS_JWT_SECRET=REPLACE_WITH_32_BYTE_OR_LONGER_SECRET
SHOPPER_API_KEYS=REPLACE_WITH_AT_LEAST_ONE_STRONG_API_KEY
ACOS_REDIS_ENABLED=true
REDIS_URL=redis://cache:6379/0
ACOS_RETAIL_PROVIDER=mock
ACOS_RETAIL_API_BASE=http://retail-mock:9006
ACOS_RETAIL_API_TIMEOUT_SECONDS=2.0
ACOS_NORTHSTAR_REQUIRE_AUTH=1
ACOS_NORTHSTAR_API_KEYS=REPLACE_WITH_KEY:default:admin|ops|analyst|viewer
ACOS_GRAPHQL_REQUIRE_AUTH=1
ACOS_GRAPHQL_API_KEYS=REPLACE_WITH_KEY:default:admin|ops|analyst|viewer
ACOS_MCP_REQUIRE_AUTH=1
ACOS_MCP_API_KEYS=REPLACE_WITH_KEY:default:admin|ops
ACOS_LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://ops.example.com,https://shopper.example.com
APP_VERSION=1.0.0
OPS_ENVIRONMENT=production
