# Production environment example for ACOS.
# Copy to your secret manager or deployment environment and replace all REPLACE_WITH_SECRET values.

APP_VERSION=1.0.0
OPS_ENVIRONMENT=production
ACOS_PLATFORM_MODE=normal
ACOS_RUNTIME_PREFERENCE=auto

# Database
DATABASE_URL=postgresql://acos:REPLACE_WITH_SECRET_STRONG_PASSWORD@db:5432/acos
DB_PASSWORD=REPLACE_WITH_SECRET_STRONG_PASSWORD
DB_BIND_ADDRESS=0.0.0.0
DB_HOST_PORT=5432

# Redis / fast-path cache
ACOS_REDIS_ENABLED=1
ACOS_REDIS_URL=redis://redis:6379/0

# API authentication
SHOPPER_API_KEYS=REPLACE_WITH_SECRET_SHOPPER_KEY_1,REPLACE_WITH_SECRET_SHOPPER_KEY_2
OPS_JWT_SECRET=REPLACE_WITH_SECRET_256_BIT_RANDOM_SECRET
CHAT_JWT_SECRET=REPLACE_WITH_SECRET_256_BIT_RANDOM_SECRET

# Production auth and mock-route posture
ALLOW_INSECURE_DEV_AUTH=0
ALLOW_MOCK_ROUTES=0
ALLOW_NON_DEV_MOCK_ROUTES=0

# CORS
ALLOWED_ORIGINS=https://shop.example.com,https://ops.example.com
VITE_API_URL=https://ops.example.com

# Optional model/provider integrations
GOOGLE_API_KEY=
AGENTFABRIC_URL=
AGENTFABRIC_API_KEY=
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_MODEL=
DOCKER_OPENAI_BASE_URL=
DOCKER_OPENAI_MODEL=

# Tenant controls
TENANT_RATE_LIMIT_PER_MINUTE=120
TENANT_DAILY_QUOTA=5000
TENANT_MAX_IN_FLIGHT=8

# Channel integrations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=default
