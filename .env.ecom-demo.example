# Copy to .env.ecom-demo before running the real ecommerce demo stack.
# This file is intentionally local-demo friendly, not production hardened.

# ACOS database
DB_PASSWORD=acos_demo_password
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=55432

# Local demo auth
SHOPPER_API_KEYS=dev-key-insecure
OPS_JWT_SECRET=dev-ops-secret-change-me
ALLOW_INSECURE_DEV_AUTH=1
ALLOW_MOCK_ROUTES=1
ACOS_NORTHSTAR_REQUIRE_AUTH=0
ACOS_GRAPHQL_REQUIRE_AUTH=0

# App/runtime
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://127.0.0.1:3000
APP_VERSION=1.0.0-ecom-demo
OPS_ENVIRONMENT=dev
ACOS_PLATFORM_MODE=normal
ACOS_RUNTIME_PREFERENCE=auto

# Real Spree demo store
SPREE_HOST_PORT=3000
SPREE_DB_HOST_PORT=55433
SPREE_REDIS_HOST_PORT=56379
SPREE_MEILI_HOST_PORT=57700
SPREE_BEARER_TOKEN=pk_acos_demo_publishable_key
SPREE_WEBHOOK_SECRET=dev-spree-webhook-secret
SPREE_SECRET_KEY_BASE=development_secret_key_base_not_for_production_use_only

# Optional LLM keys. Leave blank for deterministic/local fallback demo.
GOOGLE_API_KEY=
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_MODEL=
DOCKER_OPENAI_BASE_URL=
DOCKER_OPENAI_MODEL=

# Optional live channel integrations.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
CHAT_JWT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=default
